# ================================================================
# UXONIC Digital Solutions — Environment Variables
# ================================================================
# Add all these in Vercel Dashboard:
#   Project → Settings → Environment Variables
# NEVER commit .env.local to git.
# ================================================================

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Admin Security
ADMIN_JWT_SECRET=generate_with_openssl_rand_hex_48
ADMIN_SETUP_PASSWORD=YourAdminPasswordHere

# Email Notifications (Resend)
# Destination where admin notifications are sent (Default: uxonicdigitalmedia@gmail.com)
ADMIN_EMAIL=uxonicdigitalmedia@gmail.com

# Resend API key (from https://resend.com/api-keys)
RESEND_API_KEY=re_your_resend_api_key_here

# Sender email address.
# Testing/Default: UXONIC Digital <onboarding@resend.dev>
# Production (Once domain is verified in Resend): UXONIC Digital Solutions <contact@yourdomain.com>
RESEND_FROM=UXONIC Digital <onboarding@resend.dev>

# Allowed CORS Origins
ALLOWED_ORIGIN=https://www.uxonicdigital.com

